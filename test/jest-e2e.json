{
  "preset": "ts-jest/presets/default-esm",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^(\\.\\./src/.*)$": "<rootDir>/$1",
    "^(\\./.*)\\.js$": "$1"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@mikro-orm)"
  ]
}
